{
  "name": "everything",
  "version": "2026.1026.0",
  "description": "Every skill in this repo in one plugin: hardware-lab, agent-workflow and dev-tools combined. driver-porting moved to the driver-lab repository.",
  "author": {
    "name": "curtisgalloway",
    "url": "https://github.com/curtisgalloway"
  },
  "repository": "https://github.com/curtisgalloway/public-skills",
  "license": "Apache-2.0",
  "keywords": [
    "usb",
    "cynthion",
    "pcap",
    "reverse-engineering",
    "productivity",
    "safety",
    "learning",
    "hardware"
  ],
  "agents": [
    "./plugins/agent-workflow/skills/consult/agents/consult-runner.md"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/plugins/agent-workflow/skills/consult/scripts/runner_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
